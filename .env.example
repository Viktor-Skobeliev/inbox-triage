# Copy to .env and fill in. .env is git-ignored.
#
# Any OpenAI-compatible provider works. Pick one, put its key in LLM_API_KEY.
#   openrouter  https://openrouter.ai/keys
#   openai      https://platform.openai.com/api-keys
#   gemini      https://aistudio.google.com/apikey   (free tier is enough)
#   groq, together, or LLM_BASE_URL for anything else

LLM_PROVIDER=openrouter
LLM_API_KEY=

# Optional. Empty means the provider default:
#   openrouter -> google/gemini-2.5-flash
#   openai     -> gpt-4o-mini
#   gemini     -> gemini-2.5-flash
LLM_MODEL=

# Optional. Only needed for a provider that is not in the preset list.
LLM_BASE_URL=

LLM_TEMPERATURE=0
LLM_MAX_ATTEMPTS=3
LLM_CONCURRENCY=4

# Ask the API for a JSON object. Turn off for a model that rejects it;
# the client also drops it automatically if the server complains.
LLM_JSON_MODE=true

# Response cache. Empty value disables it.
LLM_CACHE_DIR=.cache/llm

# Only needed for --telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
